# 访问站点所需的密码，留空服务会拒绝启动。
# 这是整个站点唯一的一道门，而且暴露在公网上，务必用一个长的随机密码，不要用
# 生日 / 常见单词 / 站点名这类能猜到的东西。
# 生成方式（挑一个好念的给朋友报也行，但至少 16 位）：openssl rand -base64 18
# 登录接口带失败次数限制（同一 IP 10 分钟内 10 次），但那只能拖慢爆破，挡不住弱密码。
APP_PASSWORD=change-me

# 用于签名 session / 邀请凭证的密钥，至少 8 个字符。不是给人念的，越长越好。
# 生成方式：openssl rand -hex 32
SESSION_SECRET=change-me-too

# 宿主机映射端口（容器内固定 3000）
HOST_PORT=3000
